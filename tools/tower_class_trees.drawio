<mxfile host="app.diagrams.net"><diagram id="chain1" name="Воин"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legend" value="&lt;b&gt;Воин → Рыцарь → Берсерк / Паладин&lt;/b&gt;&lt;br&gt;Перк открывается после прохождения ЛЮБОЙ одной ветки (10 узлов).&lt;br&gt;Развилка: выбрать один из двух узлов (Урон / Крит. урон; Здоровье / Уворот; Защита / Парирование).&lt;br&gt;⚔ Урон · 💥 Крит. урон · ❤ Здоровье · 💨 Уворот · 🛡 Защита · 🤺 Парирование" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="-820" y="-100" width="560" height="140" as="geometry"/></mxCell><mxCell id="n0" value="Воин" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5b041;strokeColor=#7e5109;strokeWidth=5;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-90.0" y="-90.0" width="180" height="180" as="geometry"/></mxCell><mxCell id="n1" value="Рыцарь" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5b041;strokeColor=#7e5109;strokeWidth=5;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-90.0" y="3732.7" width="180" height="180" as="geometry"/></mxCell><mxCell id="n2" value="Выбор эволюции&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;Рыцарь&lt;/span&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#6c3483;strokeColor=#2e1a47;strokeWidth=3;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-77.9" y="7577.8" width="140" height="58" as="geometry"/></mxCell><mxCell id="n3" value="Берсерк" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5b041;strokeColor=#7e5109;strokeWidth=5;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-500.0" y="7721.9" width="180" height="180" as="geometry"/></mxCell><mxCell id="n4" val