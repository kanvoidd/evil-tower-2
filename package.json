{
  "name": "evil-tower-2",
  "private": true,
  "version": "0.1.0",
  "description": "Evil Tower 2 — карточный рогалик для Яндекс Игр (Phaser 3 + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "skilltree": "node tools/convert-skilltree.mjs",
    "sim": "tsx tools/sim.ts",
    "selftest": "tsx tools/selftest.ts",
    "store": "tsx tools/store-assets.ts && python store/render.py",
    "zip": "node tools/zip-dist.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
